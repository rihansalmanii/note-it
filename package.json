{
  "name": "note-it",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && node index.js",
    "dev:frontend": "cd frontend && npx vite",
    "dev:electron": "cross-env ELECTRON_DEV=true electron .",
    "build": "cd frontend && npm run build && cd .. && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "axios": "1.20.0"
  }
}
